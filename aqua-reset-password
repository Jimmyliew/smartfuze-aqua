#!/usr/bin/env bash
# Reset the dashboard password (user admin). Every phone must sign in again.
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "请用 sudo aqua-reset-password"; exit 1; }
while :; do
  read -r -s -p "新密码（至少 10 位）: " PW; echo
  [ "${#PW}" -ge 10 ] || { echo "太短"; continue; }
  read -r -s -p "再输入一次: " PW2; echo
  [ "$PW" = "$PW2" ] && break
  echo "两次不一样"
done
systemctl stop aqua
runuser -u aqua -- env AQUA_DATA_DIR=/var/lib/aqua AQUA_NEW_PASSWORD="$PW" node /opt/aqua/tools/admin.js set-password admin
systemctl start aqua
echo "密码已重设。"
