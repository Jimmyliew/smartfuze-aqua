#!/usr/bin/env bash
# Update SMARTFUZE AQUA from GitHub. Data, logins and settings are kept.
set -euo pipefail
# GitHub's web upload sometimes drops folders and puts every file at the top level.
# Rebuild the folder layout from the file names so a "flat" repository still installs.
normalize_layout() {
  local d="$1"
  [ -f "$d/server.js" ] || return 0
  [ -f "$d/lib/store.js" ] && return 0
  echo "检测到 GitHub 上的文件没有文件夹结构，自动整理中..."
  _mv_to() {
    local dest="$1"; shift
    mkdir -p "$d/$dest"
    for f in "$@"; do if [ -f "$d/$f" ]; then mv "$d/$f" "$d/$dest/$f"; fi; done
  }
  _mv_to lib alerts.js aquaculture.js auth.js bus.js notify.js ph.js store.js rbac.js audit.js business.js receipt.js
  _mv_to public/vendor/ocr tesseract.min.js worker.min.js LICENSE-tesseract.js.txt
  _mv_to public/vendor/ocr/core tesseract-core-lstm.wasm.js tesseract-core-simd-lstm.wasm.js
  _mv_to public/vendor/ocr/lang eng.traineddata.gz chi_sim.traineddata.gz msa.traineddata.gz
  _mv_to public/vendor/pdf pdf.min.js pdf.worker.min.js LICENSE-pdfjs.txt
  _mv_to tests run.js
  _mv_to public app.js index.html manifest.webmanifest styles.css sw.js icon.svg
  _mv_to public/icons apple-touch-icon.png icon-192.png icon-512.png icon-maskable-512.png
  _mv_to cloud install.sh aqua-update aqua-reset-password
  _mv_to tools admin.js
  _mv_to docs CLOUD_SETUP_ZH.md HARDWARE_ZH.md wiring.svg
  _mv_to firmware/SMARTFUZE_AQUA_ESP32 SMARTFUZE_AQUA_ESP32.ino
  local missing=""
  for f in package.json lib/store.js lib/ph.js lib/alerts.js lib/aquaculture.js lib/notify.js lib/auth.js lib/bus.js \
           public/app.js public/index.html public/styles.css tools/admin.js cloud/aqua-update cloud/aqua-reset-password; do
    [ -f "$d/$f" ] || missing="$missing $f"
  done
  if [ -n "$missing" ]; then echo "GitHub 仓库缺少这些文件：$missing"; return 1; fi
  echo "文件整理完成。"
}

# Simplest update: upload ONE zip (SMARTFUZE-AQUA-x.y.z-github-upload.zip) to the GitHub repository.
# If the download contains a zip with AQUA inside, the newest one (by version in its name) is used.
use_zip_if_present() {
  local d="$1" z x top
  z="$(find "$d" -maxdepth 1 -type f -iname '*.zip' | sort -V | tail -n 1)"
  [ -n "$z" ] || return 0
  echo "发现压缩包 $(basename "$z")，使用里面的版本 ..."
  x="$(mktemp -d)"
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$z" "$x" <<'PY' || { rm -rf "$x"; return 1; }
import os, sys, zipfile
src, out = sys.argv[1], sys.argv[2]
with zipfile.ZipFile(src) as f:
    for m in f.infolist():
        p = os.path.normpath(m.filename)
        if p.startswith('..') or os.path.isabs(p) or ':' in p:
            sys.exit('压缩包里有不安全的路径: ' + m.filename)
    f.extractall(out)
PY
  else
    apt-get install -y unzip >/dev/null 2>&1 || true
    unzip -q "$z" -d "$x" || { rm -rf "$x"; return 1; }
  fi
  top="$x"
  if [ ! -f "$top/server.js" ] && [ "$(find "$x" -mindepth 1 -maxdepth 1 | wc -l)" -eq 1 ]; then
    top="$(find "$x" -mindepth 1 -maxdepth 1 -type d)"
  fi
  if [ ! -f "$top/server.js" ] && [ ! -f "$top/lib/store.js" ] && [ ! -f "$top/store.js" ]; then
    echo "压缩包 $(basename "$z") 里找不到 AQUA 程序 (server.js)"; rm -rf "$x"; return 1
  fi
  find "$d" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
  cp -a "$top"/. "$d"/
  rm -rf "$x" "$d/node_modules" "$d/data"
  echo "已使用压缩包里的程序。"
}

[ "$(id -u)" -eq 0 ] || { echo "请用 sudo aqua-update"; exit 1; }
REPO="$(sed -n 1p /etc/aqua/repo)"; BRANCH="$(sed -n 2p /etc/aqua/repo)"
APP=/opt/aqua
TMP="$(mktemp -d)"
echo "下载 $REPO ($BRANCH) ..."
curl -fsSL "https://codeload.github.com/$REPO/tar.gz/refs/heads/$BRANCH" | tar xz -C "$TMP" --strip-components=1
use_zip_if_present "$TMP" || { echo "已取消更新，现有版本继续运行"; exit 1; }
[ -f "$TMP/server.js" ] || { echo "下载内容不完整，已取消"; exit 1; }
normalize_layout "$TMP" || { echo "已取消更新，现有版本继续运行"; exit 1; }
rm -rf "$APP.new"; mkdir -p "$APP.new"; cp -a "$TMP"/. "$APP.new"/; rm -rf "$APP.new/data" "$APP.new/node_modules" "$TMP"
( cd "$APP.new" && { npm ci --omit=dev --no-audit --no-fund || npm install --omit=dev --no-audit --no-fund; } )
/usr/local/bin/aqua-backup || true
rm -rf "$APP.old"; mv "$APP" "$APP.old"; mv "$APP.new" "$APP"; chown -R root:root "$APP"; chmod 755 "$APP"; chmod -R a+rX "$APP"
install -m 755 "$APP/cloud/aqua-update" /usr/local/bin/aqua-update
install -m 755 "$APP/cloud/aqua-reset-password" /usr/local/bin/aqua-reset-password
systemctl restart aqua
sleep 3
if curl -fsS http://127.0.0.1:3000/api/auth/status >/dev/null; then
  echo "更新完成，AQUA 运行中。"
else
  echo "新版本启动失败，恢复旧版本..."
  rm -rf "$APP"; mv "$APP.old" "$APP"; systemctl restart aqua
  echo "已恢复。运行 journalctl -u aqua -n 50 查看原因。"; exit 1
fi
